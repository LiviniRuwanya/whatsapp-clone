# Copy this file to .env and fill in real values before starting the server.
#   cp .env.example .env   (or copy/paste on Windows)
#
# .env is gitignored — never commit real secrets.

# Required. Long random string used to sign login tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# How long a login token stays valid (e.g. 7d, 24h, 1h).
JWT_EXPIRES_IN=7d

# Port the server listens on.
PORT=3000

# Set to "production" on a real deploy (disables /api/dev demo seeding).
# NODE_ENV=production
